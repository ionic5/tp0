                    <engine:Button text="+" name="PlusButton" enabled="true" style="width: 45px; height: 45px; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; align-self: center;" />
                    <engine:Button text="-" name="MinusButton" style="width: 45px; height: 45px; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; align-self: center;" />
                </engine:VisualElement>
